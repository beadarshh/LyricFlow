<Window x:Class="LyricFlow.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LyricFlow.UI"
        Title="LyricFlow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        SizeToContent="Height"
        Width="1000">
    <Grid>
        <Border x:Name="MoveFrame"
                Visibility="Collapsed"
                Background="#40000000"
                BorderBrush="#80FFFFFF"
                BorderThickness="1"
                CornerRadius="12" />
        <ui:LyricsView x:Name="View" />
    </Grid>
</Window>
